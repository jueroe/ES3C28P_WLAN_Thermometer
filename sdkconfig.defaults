# Board: QDtech / LCDWiki 2.8inch ESP32-S3 Display (ES3C28P)
# Module: ESP32-S3R8, 16 MB QSPI flash, 512 KB SRAM, 8 MB OPI PSRAM

CONFIG_IDF_TARGET="esp32s3"

# The module carries 16 MB of flash and 8 MB of octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Full 240 MHz for smooth drawing into the framebuffer
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The Type-C socket is wired to the ESP32-S3 native USB (IO19/IO20), so the
# monitor output and esptool use the USB Serial/JTAG peripheral.  The UART0
# pins (IO43/44) are only on the 1.25 mm connector.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Custom partition table (see partitions.csv): 4 MB application plus a 4 MB
# littlefs partition for the wallpaper JPEGs.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# littlefs: the wallpaper file names reach 73 characters (littlefs limit is
# this value minus the NULL terminator), so raise it from the default 64.
# The image build passes the same value as --name-max.
CONFIG_LITTLEFS_OBJ_NAME_LEN=128

# WiFi buffers live in static RAM: a thermometer needs neither WPA3-Enterprise
# nor WPS, so those stay out.  The access point *is* needed: without it the
# WLAN cannot be configured on the device (see main/configmode.c).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Fewer static RX buffers and no NTP-scale traffic; the dynamic buffers take
# over when more frames arrive.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2

# HTTPS for the sunrise-sunset request needs the default 16 KB TLS record
# buffer: the certificate chain of the server arrives as one record and does not
# fit into a smaller buffer (the handshake fails with a fatal error).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# api.sunrise-sunset.org presents its root "GTS Root R4" in the cross-signed
# variant (signed by GlobalSign Root CA, which is not in the bundle).  Without
# this option the device gives up with "No matching trusted root certificate
# found"; with it, mbedtls matches the cross-signed root against the bundle's
# self-signed GTS Root R4.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
